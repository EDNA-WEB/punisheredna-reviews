# Pripojenie na Postgres databázu (napr. z neon.tech, zadarmo)
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&channel_binding=require"

# Priame (nie "pooled") pripojenie na tú istú databázu — potrebné pre "npx prisma migrate".
# V Neon dashboarde nájdeš pri Connection Details prepínač "Pooled connection" — vypni ho
# a skopíruj si zobrazený connection string sem (hostname bude bez "-pooler").
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vygeneruj príkazom: openssl rand -base64 32
NEXTAUTH_SECRET="zmen-ma-na-nahodny-retazec"
NEXTAUTH_URL="http://localhost:3000"

# Prvý administrátorský účet — vytvorí sa pri "npx prisma db seed"
ADMIN_EMAIL="admin@priklad.sk"
ADMIN_PASSWORD="zmen-toto-heslo"
ADMIN_NAME="Filmový Kritik"

# Cloudinary — ukladanie obrázkov mimo databázy. Hodnoty nájdeš vo svojom
# Cloudinary dashboarde (Settings → API Keys). Nikdy tieto hodnoty nezdieľaj
# verejne ani v chate — ak sa niekedy vyzradia, v dashboarde si vygeneruj nový secret.
CLOUDINARY_CLOUD_NAME="tvoj-cloud-name"
CLOUDINARY_API_KEY="tvoj-api-key"
CLOUDINARY_API_SECRET="tvoj-api-secret"

# Resend (odosielanie overovacích e-mailov). Skopíruj z resend.com → API Keys.
# Nikdy sem nedávaj skutočnú hodnotu — len do .env (ktorý sa na GitHub nenahráva).
RESEND_API_KEY="tvoj-resend-api-kluc"

# Náhodný tajný reťazec na ochranu automatickej dennej úlohy (cron), čo sťahuje
# populárne tituly z TMDb. Vymysli si ľubovoľný dlhý náhodný text.
CRON_SECRET="tvoj-nahodny-tajny-retazec"

# Kľúč, čo šifruje text súkromných správ v Pošte, priamo na serveri. Vymysli si
# akýkoľvek dlhý náhodný text (napr. 40+ znakov) a ULOŽ SI HO NIEKAM BOKOM —
# ak sa niekedy zmení, všetky doteraz uložené správy sa prestanú dať dešifrovať.
MESSAGE_ENCRYPTION_KEY="tvoj-velmi-dlhy-nahodny-tajny-retazec-min-32-znakov"
