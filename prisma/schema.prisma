generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  READER
}

model User {
  mustVerifyEmail      Boolean   @default(false)
  verificationSentAt   DateTime?
  passwordResetHash    String?   @unique
  passwordResetExpires DateTime?
  passwordResetSentAt  DateTime?
  passwordChangedAt    DateTime?
  emailNews            Boolean   @default(false)
  emailOnline          Boolean   @default(true)
  emailMessages        Boolean   @default(true)
  recentlyViewed RecentlyViewed[]
  id           String    @id @default(cuid())
  email        String    @unique
  lastActiveAt DateTime  @default(now())
  favoritesVisibility String @default("EVERYONE")
  reviewLanguages String @default("cs")
  emailVerified       Boolean  @default(false)
  verificationToken   String?  @unique
  passwordHash String
  name         String    @unique
  avatar       String?   @db.Text
  bio          String?   @db.Text
  role         Role      @default(READER)
  banned       Boolean   @default(false)
  reviewsDisabled  Boolean @default(false)
  ratingsDisabled  Boolean @default(false)
  commentsDisabled Boolean @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  timezone            String?
  recoveryCode        String?  @unique
  deleted             Boolean  @default(false)
  firstName           String?
  lastName            String?
  gender              String?
  birthDate           DateTime?
  tagline             String?
  hideEmail           Boolean  @default(false)
  homepage            String?
  facebookUrl         String?
  instagramUrl        String?
  tiktokUrl           String?
  xUrl                String?
  youtubeUrl          String?
  spotifyUrl          String?
  linkedinUrl         String?
  snapchatUrl         String?
  blueskyUrl          String?
  country             String?
  region              String?
  language            String   @default("cs")
  createdAt    DateTime  @default(now())
  reviews      Review[]
  ratings      Rating[]
  watchedEpisodes WatchedEpisode[]
  membershipUntil DateTime?
  // Obmedzené admin právo — momentálne jediné dostupné je "Redaktor":
  // vidí tlačidlo Administrácia, ale smie v nej len pridávať novinky,
  // nič iné. Systém je pripravený na pridanie ďalších obmedzených práv
  // v budúcnosti (zatiaľ len toto jedno).
  isEditor Boolean @default(false)
  commentReactions CommentReaction[]
  qrLoginSessions QrLoginSession[]
  onlineReports OnlineReport[]
  redeemedTrial   Boolean  @default(false)
  membershipCodesUsed MembershipCode[]
  articleRevisions ArticleRevision[]
  contentSubmissions ContentSubmission[]
  seasonNotes        SeasonNote[]
  episodeNotes       EpisodeNote[]
  shopReviews        ShopReview[]
  messageReportsSent     MessageReport[] @relation("reportedMessages")
  messageReportsReceived MessageReport[] @relation("receivedMessageReports")
  comments     Comment[]
  threads          Thread[]
  posts            Post[]
  likes            Like[]
  personFollows    PersonFollow[]
  profileVisitsMade     ProfileVisit[] @relation("visitorOf")
  profileVisitsReceived ProfileVisit[] @relation("visitedBy")
  activities       UserActivity[]
  feedEvents       FeedEvent[]
  pushTokens       PushToken[]
  movieNotes       MovieNote[]
  watchlist        WatchlistItem[]
  discussionFollows MovieDiscussionFollow[]
  blogPosts        BlogPost[]
  movieLists       MovieList[]
  submittedMovies  Movie[]        @relation("submittedMovies")
  submittedPeople  Person[]       @relation("submittedPeople")
  following        Follow[]       @relation("follower")
  followedBy       Follow[]       @relation("following")
  sentMessages     Message[]      @relation("sender")
  receivedMessages Message[]      @relation("receiver")
  notifications    Notification[]
  news             NewsPost[]
  @@index([createdAt])
}

enum PersonRole {
  ACTOR
  CREATOR
}

model Person {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  photo      String?        @db.Text
  role       PersonRole     @default(ACTOR)
  subRole    String?
  bio        String?        @db.Text
  birthDate  DateTime?
  deathDate  DateTime?
  birthPlace String?
  deathPlace String?
  tmdbId     Int?
  approved   Boolean        @default(true)
  submittedById String?
  submittedBy   User?        @relation("submittedPeople", fields: [submittedById], references: [id])
  createdAt  DateTime       @default(now())
  followers  PersonFollow[]

  @@index([approved, role])
  @@index([submittedById])
  @@index([tmdbId])
}

model PersonFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, personId])
  @@index([personId])
}

// Zmeny profilu pre "Aktivitu obľúbených" (nová profilová fotka, upravené
// údaje v profile). Ostatná aktivita sa skladá z existujúcich tabuliek.
model FeedEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// "Píše…" v chate — kto (userId) práve píše komu (otherId). Záznam starší
// ako pár sekúnd sa považuje za ukončené písanie (bez websocketov).
model TypingStatus {
  userId    String
  otherId   String
  updatedAt DateTime @default(now())

  @@id([userId, otherId])
  @@index([otherId, updatedAt])
}

// Push notifikácie do mobilnej appky (Expo). Jedno zariadenie = jeden token,
// s vlastným nastavením upozornení a zvuku z Nastavení appky.
model PushToken {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String?
  notifyMessages Boolean  @default(true)
  sound          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// Monitoring záťaže databázy (Administrácia → Výkon). Súhrn za hodinu podľa
// toho, odkiaľ dopyt prišiel (stránka/API) a nad čím (model + operácia).
model PerfStat {
  id      String   @id
  hour    DateTime
  source  String
  model   String
  action  String
  count   Int      @default(0)
  totalMs Float    @default(0)
  maxMs   Float    @default(0)

  @@unique([hour, source, model, action])
  @@index([hour])
}

// Počet dopytov za každú minútu — z toho sa odhaduje, koľko času bola
// databáza prebudená (Neon sa uspí až 5 minút po poslednom dopyte).
model PerfMinute {
  minute  DateTime @id
  queries Int      @default(0)
  totalMs Float    @default(0)
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  link      String
  createdAt DateTime @default(now())
  @@index([userId])
}

model MovieNote {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, userId])
  @@index([userId])
}

model SeasonNote {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, userId])
  @@index([userId])
}

model EpisodeNote {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeId, userId])
  @@index([userId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
  @@index([movieId])
}

model TranslationString {
  id        String   @id @default(cuid())
  key       String   @unique
  group     String
  sk        String   @db.Text
  en        String?  @db.Text
  cs        String?  @db.Text
  updatedAt DateTime @updatedAt
}

model CaptchaChallenge {
  id        String   @id @default(cuid())
  code      String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProfileVisit {
  id             String   @id @default(cuid())
  visitorId      String
  visitor        User     @relation("visitorOf", fields: [visitorId], references: [id], onDelete: Cascade)
  profileOwnerId String
  profileOwner   User     @relation("visitedBy", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  visitedAt      DateTime @default(now())
  @@index([visitorId])
  @@index([profileOwnerId])
}

model Thread {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id])
  posts     Post[]

  @@index([authorId, createdAt])
  @@index([movieId])
}

model Movie {
  onlineNotifiedAt DateTime?
  fanFavorites FanFavorite[]
  recentlyViewed RecentlyViewed[]
  id             String   @id @default(cuid())
  title          String
  originalTitle  String?
  slug           String   @unique
  poster         String?  @db.Text
  genres         String?
  countries      String?
  year           String?
  runtimeMinutes Int?
  director       String?
  screenplay     String?
  cinematography String?
  music          String?
  cast           String?  @db.Text
  synopsis       String?  @db.Text
  trailerUrl     String?
  watchUrl       String?
  isCamVersion   Boolean  @default(false)
  onlineImage    String? @db.Text
  nowShowing     Boolean  @default(false)
  distributor    String?
  tags           String?
  contentType    String   @default("Film")
  hasSubtitles   Boolean  @default(false)
  hasDubbing     Boolean  @default(false)
  releaseDate    DateTime?
  approved       Boolean  @default(true)
  submittedById  String?
  submittedBy    User?    @relation("submittedMovies", fields: [submittedById], references: [id])
  budget         BigInt?
  marketingBudget BigInt?
  boxOffice      BigInt?
  domesticBoxOffice BigInt?
  internationalBoxOffice BigInt?
  chinaBoxOffice BigInt?
  ancillaryRevenue BigInt?
  // Uložené (nie priebežne prepočítavané) poradie v Box Office rebríčku —
  // prepočíta sa hromadne cez admin tlačidlo, nie pri každom zobrazení
  // stránky filmu, nech to zbytočne nezaťažuje databázu.
  boxOfficeRank     Int?
  boxOfficeRankType String?
  // Popularita z TMDb (0 = nenatiahnuté/neznáme) — používa sa napr. na
  // zoradenie filmov bez online odkazu podľa toho, ako veľmi sú známe,
  // keďže počet hodnotení na vlastnom webe je zatiaľ nízky pre spoľahlivé
  // porovnanie. Dopĺňa sa hromadne cez admin tlačidlo, nie automaticky.
  tmdbPopularity Float?
  // Hodnotenie divákov priamo z TMDb (0-10) a počet hlasov — kombinuje sa s
  // vlastným hodnotením na webe do jedného zobrazeného percenta, keďže
  // vlastných hodnotení je zatiaľ na väčšine filmov málo na to, aby boli
  // samy o sebe vypovedajúce o kvalite.
  tmdbVoteAverage Float?
  tmdbVoteCount   Int?
  createdAt      DateTime @default(now())
  reviews        Review[]
  ratings        Rating[]
  threads        Thread[]
  newsPosts      NewsPost[]
  notes          MovieNote[]
  watchlistedBy  WatchlistItem[]
  photos         MoviePhoto[]
  trivia         MovieTrivia[]
  videos         MovieVideo[]
  comments       Comment[]
  discussionFollows MovieDiscussionFollow[]
  listItems      MovieListItem[]
  seasons        Season[]
  streamingServices MovieStreamingService[]
  keywords MovieKeyword[]
  links MovieLink[]
  premiereDates MoviePremiereDate[]
  onlineReports OnlineReport[]
  tmdbId Int?
  contentSubmissions ContentSubmission[]
  ageRating String?

  @@index([approved])
  @@index([submittedById])
  @@index([approved, createdAt])
}

model MovieDiscussionFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, movieId])
  @@index([movieId])
}

model MovieVideo {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seasonId  String?
  season    Season?  @relation("SeasonVideos", fields: [seasonId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation("EpisodeVideos", fields: [episodeId], references: [id], onDelete: Cascade)
  url       String
  category  String   @default("trailer")
  title     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  previewImage String? @db.Text
  featuredOnHome Boolean @default(false)
  subtitles VideoSubtitle[]
  trailerViews TrailerView[]

  @@index([movieId])
  @@index([seasonId])
  @@index([episodeId])
}

model Season {
  id           String    @id @default(cuid())
  movieId      String
  movie        Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  number       Int
  year         String?
  synopsis     String?   @db.Text
  episodeCount Int       @default(0)
  released     Boolean   @default(true)
  releaseDate  DateTime?
  order        Int       @default(0)
  episodes     Episode[]
  ratings      Rating[]
  reviews      Review[]
  videos       MovieVideo[] @relation("SeasonVideos")
  notes        SeasonNote[]
  photos       MoviePhoto[]

  @@index([movieId])
  @@unique([movieId, number])
}

model Episode {
  id       String   @id @default(cuid())
  seasonId String
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number   Int
  title    String?
  synopsis String?  @db.Text
  onlineImage String? @db.Text
  onlineUrl   String?
  releaseDate DateTime?
  order    Int      @default(0)
  ratings  Rating[]
  reviews  Review[]
  photos   MoviePhoto[]
  videos   MovieVideo[] @relation("EpisodeVideos")
  watchedBy WatchedEpisode[]
  notes    EpisodeNote[]

  @@index([seasonId])
  @@unique([seasonId, number])
}

model WatchedEpisode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())

  @@unique([userId, episodeId])
  @@index([episodeId])
}

model MembershipCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String
  forUserId      String?
  usedByUserId   String?
  usedBy         User?     @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)
  usedAt         DateTime?
  createdByAdminId String?
  createdAt      DateTime  @default(now())

  @@index([usedByUserId])
}

model VideoSubtitle {
  id           String     @id @default(cuid())
  movieVideoId String
  movieVideo   MovieVideo @relation(fields: [movieVideoId], references: [id], onDelete: Cascade)
  startTime    Float
  endTime      Float
  text         String     @db.Text
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([movieVideoId])
}

model MovieTrivia {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([movieId])
}

model MoviePhoto {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  thumbnail String   @db.Text
  full      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([movieId])
  @@index([seasonId])
  @@index([episodeId])
}

model ShopCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  icon      String?       @db.Text
  order     Int           @default(0)
  products  ShopProduct[]
}

model ShopProduct {
  id            String              @id @default(cuid())
  categoryId    String
  category      ShopCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title         String
  slug          String              @unique
  image         String?             @db.Text
  platform      String?
  type          String              @default("Predplatné")
  region        String              @default("SLOVENSKO")
  description   String?             @db.Text
  activationInfo String?            @db.Text
  sellerName    String?
  approved      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  variants      ShopProductVariant[]
  reviews       ShopReview[]

  @@index([categoryId])
  @@index([approved])
}

model ShopReview {
  id        String      @id @default(cuid())
  productId String
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?     @db.Text
  createdAt DateTime    @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

model ShopProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  price         Float
  originalPrice Float?
  currency      String      @default("EUR")
  isBestDeal    Boolean     @default(false)
  isGreatPrice  Boolean     @default(false)
  order         Int         @default(0)

  @@index([productId])
}

model StreamingService {
  id     String   @id @default(cuid())
  name   String   @unique
  icon   String?  @db.Text
  color  String?
  order  Int      @default(0)
  movies MovieStreamingService[]
}

model MovieStreamingService {
  id                 String            @id @default(cuid())
  movieId            String
  movie              Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)
  streamingServiceId String
  streamingService   StreamingService  @relation(fields: [streamingServiceId], references: [id], onDelete: Cascade)
  url                String
  createdAt          DateTime          @default(now())

  @@unique([movieId, streamingServiceId])
  @@index([movieId])
}

model MovieLinkType {
  id     String   @id @default(cuid())
  name   String   @unique
  icon   String?  @db.Text
  color  String?
  order  Int      @default(0)
  links  MovieLink[]
}

model MovieLink {
  id          String        @id @default(cuid())
  movieId     String
  movie       Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  linkTypeId  String
  linkType    MovieLinkType @relation(fields: [linkTypeId], references: [id], onDelete: Cascade)
  url         String
  createdAt   DateTime      @default(now())

  @@unique([movieId, linkTypeId])
  @@index([movieId])
}

model ContentSubmission {
  id         String   @id @default(cuid())
  movieId    String
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type       String   @default("CONTENT")
  body       String   @db.Text
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([movieId])
  @@index([status])
}

model Rating {
  id        String   @id @default(cuid())
  movieId   String
  userId    String
  seasonId  String?
  episodeId String?
  value     Float
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([movieId, userId, seasonId, episodeId])
  @@index([userId])
  @@index([seasonId])
  @@index([episodeId])
  @@index([createdAt])
}

model Review {
  id        String    @id @default(cuid())
  movieId   String
  seasonId  String?
  episodeId String?
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  String
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  season    Season?   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episode   Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]

  @@unique([movieId, authorId, seasonId, episodeId])
  @@index([authorId, createdAt])
  @@index([seasonId])
  @@index([episodeId])
  @@index([createdAt])
}

model Settings {
  // Dočasné verejné zdieľanie článkov (Administrace → Sdílení článků)
  articleShareEnabled Boolean @default(false)
  // Tajná „soľ“ zdieľacích kľúčov — jej zmenou sa zneplatnia všetky odkazy
  articleShareSalt    String?
  id            String  @id @default("singleton")
  wallpaper     String? @db.Text
  mobileWallpaper String? @db.Text
  mobileLogo    String? @db.Text
  appStoreUrl   String?
  googlePlayUrl String?
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  privacyModalText String? @db.Text
  privacyCategories String? @db.Text
  cookiesPolicyText String? @db.Text
  rulesText String? @db.Text
  privacyPolicyText String? @db.Text
  registrationsEnabled Boolean @default(true)
  onlineFreeForAll Boolean @default(false)
  buyMeACoffeeUrl String?
  boxOfficeRankedTotal Int?
}

// Nahlásenie od diváka, že film/seriál chýba online, alebo že jeho odkaz
// na sledovanie nefunguje — vidí to admin v Administrácia → Online.
model OnlineReport {
  id         String   @id @default(cuid())
  movieId    String
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  note       String?  @db.Text
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([movieId])
  @@index([resolved])
}

model MoviePremiereDate {
  id          String   @id @default(cuid())
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  country     String
  type        String   @default("KINO")
  releaseDate DateTime
  distributor String?
  createdAt   DateTime @default(now())

  @@index([movieId])
}

model MovieKeyword {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([movieId, name])
  @@index([movieId])
}

model TrailerView {
  id           String      @id @default(cuid())
  movieVideoId String?
  movieVideo   MovieVideo? @relation(fields: [movieVideoId], references: [id], onDelete: Cascade)
  viewedAt     DateTime    @default(now())
  @@index([movieVideoId])
}

model NewsPost {
  emailedAt    DateTime?
  emailedCount Int?
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  summary    String
  body       String    @db.Text
  tags       String[]  @default([])
  coverImage String?   @db.Text
  createdAt  DateTime  @default(now())
  publishAt  DateTime?
  isDraft    Boolean   @default(false)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  likes      Like[]
  comments   Comment[]
  movieId    String?
  movie      Movie?    @relation(fields: [movieId], references: [id])
  fromBlogPost BlogPost?
  revisions  ArticleRevision[] @relation("NewsRevisions")
  @@index([authorId])
  @@index([movieId])
}

model ArticleRevision {
  id         String    @id @default(cuid())
  newsPostId String?
  newsPost   NewsPost? @relation("NewsRevisions", fields: [newsPostId], references: [id], onDelete: Cascade)
  blogPostId String?
  blogPost   BlogPost? @relation("BlogRevisions", fields: [blogPostId], references: [id], onDelete: Cascade)
  title      String
  summary    String?
  body       String    @db.Text
  coverImage String?   @db.Text
  editedById String
  editedBy   User      @relation(fields: [editedById], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([newsPostId])
  @@index([blogPostId])
}

model BulkImportChange {
  id         String   @id @default(cuid())
  batchId    String
  importType String
  targetType String
  targetId   String
  movieTitle String
  field      String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  wasCreated Boolean  @default(false)
  undone     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([batchId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  userName    String
  action      String
  targetType  String
  targetId    String
  targetTitle String
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model ArticleView {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model MovieList {
  id        String          @id @default(cuid())
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime        @default(now())
  items     MovieListItem[]
  @@index([authorId])
}

model MovieListItem {
  id        String    @id @default(cuid())
  listId    String
  list      MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@unique([listId, movieId])
  @@index([movieId])
}

model BlogPost {
  id                   String    @id @default(cuid())
  authorId             String
  author               User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title                String
  body                 String    @db.Text
  tags                 String[]  @default([])
  coverImage           String?   @db.Text
  isDraft              Boolean   @default(false)
  publicationRequested Boolean   @default(false)
  published            Boolean   @default(false)
  newsPostId           String?   @unique
  newsPost             NewsPost? @relation(fields: [newsPostId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  revisions            ArticleRevision[] @relation("BlogRevisions")
  @@index([authorId])
  @@index([newsPostId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String?  @db.Text
  iv         String?
  image      String?  @db.Text
  imageViewedAt DateTime?
  // Fotka v chate: zostáva 24 h od odoslania, potom sa zmaže z Cloudinary aj
  // z DB (ostane photo=true → „Fotka vypršela“). Max. 5 naraz, 10 za deň.
  photo          Boolean   @default(false)
  imagePublicId  String?
  imageExpiresAt DateTime?
  // Discord-like akcie: úprava, odpoveď, preposlanie, pripnutie, reakcie.
  editedAt       DateTime?
  replyToId      String?
  forwarded      Boolean   @default(false)
  pinnedAt       DateTime?
  pinnedById     String?
  reactions      MessageReaction[]
  // Hlasovka (nahrať sa dá len v appke). Súbor je v Cloudinary ako
  // "authenticated" (nie verejný). Zmaže sa 5 min po vypočutí príjemcom,
  // najneskôr 5 h po odoslaní — potom ostane len voice=true ako "vypršela".
  voice           Boolean   @default(false)
  audioPublicId   String?
  audioFormat     String?
  audioDuration   Int?
  audioWaveform   String?   @db.Text
  audioListenedAt DateTime?
  audioExpiresAt  DateTime?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  sender     User     @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([receiverId])
  @@index([audioExpiresAt])
  @@index([imageExpiresAt])
  @@index([senderId, photo, createdAt])
}

// Súhlas s komunikáciou medzi dvoma používateľmi — kým adresát prvú správu
// výslovne neprijme, odosielateľ nemôže poslať ďalšiu (žiadny spam). Jeden
// riadok na dvojicu používateľov, userAId je vždy abecedne/hodnotovo menšie
// ako userBId, aby dvojica nemohla vzniknúť dvakrát v opačnom poradí.
model Conversation {
  id           String    @id @default(cuid())
  userAId      String
  userBId      String
  initiatorId  String
  status       String    @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  // Posledná zmena bez novej správy (reakcia, úprava, pripnutie, zmazanie) —
  // otvorený chat podľa nej vie, že sa má obnoviť.
  activityAt   DateTime?

  @@unique([userAId, userBId])
}

// Reakcia na správu (ako Discord) — jeden používateľ môže dať na jednu správu
// viac rôznych emoji, každé najviac raz.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Vymazanie konverzácie je "len pre mňa" — skryje staré správy len tomu, kto
// zmazanie vykonal, druhá strana o tom ani nevie a jej história ostáva netknutá.
model ConversationDeletion {
  id        String   @id @default(cuid())
  userId    String
  otherId   String
  deletedAt DateTime @default(now())

  @@unique([userId, otherId])
}

// Zablokovanie iného používateľa v Pošte — blocker už od blocked nedostane
// žiadnu správu a nemôže mu ani sám písať.
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// Nahlásenie konverzácie adminovi — keďže text správ je v databáze zašifrovaný,
// zachytíme si v momente nahlásenia jeho dešifrovaný odpis (transcript), aby ho
// admin vedel neskôr posúdiť aj bez schopnosti dešifrovať priamo databázu.
model MessageReport {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("reportedMessages", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User     @relation("receivedMessageReports", fields: [reportedUserId], references: [id], onDelete: Cascade)
  transcript     String   @db.Text
  reviewed       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([reviewed])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorName String
  type      String
  text      String
  link      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// Reakcie na komentáre (podobne ako WhatsApp) — dostupné len pre Golden
// Ticket členov. Jeden používateľ môže mať na jeden komentár len JEDNU
// reakciu naraz (zmena reakcie prepíše predošlú, presne ako vo WhatsApp).
// Prihlásenie pomocou QR kódu — prehliadač si vytvorí jeden takýto záznam a
// zobrazí jeho "token" ako QR kód. Používateľ ho naskenuje MOBILOM, na
// ktorom je už prihlásený, potvrdí tam prihlásenie, a pôvodný prehliadač
// (čo priebežne kontroluje stav cez "status") sa automaticky prihlási.
// Krátka platnosť (pár minút) — nepoužitý/nepotvrdený záznam rýchlo vyprší.
model QrLoginSession {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending | approved | expired
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Prehliadač/systém zariadenia, čo QR kód VYTVORILO (t.j. zariadenie, na
  // ktoré sa niekto snaží prihlásiť) — zobrazuje sa na potvrdzovacej stránke,
  // nech si to používateľ vie overiť pred potvrdením.
  requestingDevice String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([status, expiresAt])
  // Čistenie starých QR kódov maže podľa expiresAt — bez tohto indexu to trvalo aj minúty.
  @@index([expiresAt])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

model Comment {
  id        String    @id @default(cuid())
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  reviewId  String?
  review    Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  newsId    String?
  news      NewsPost? @relation(fields: [newsId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  likes     Like[]
  reactions CommentReaction[]
  parentId  String?
  parent    Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("replies")

  @@index([userId, createdAt])
  @@index([movieId])
  @@index([reviewId])
  @@index([newsId])
  @@index([parentId])
}

model Post {
  id        String   @id @default(cuid())
  body      String   @db.Text
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  likes     Like[]

  @@index([authorId, createdAt])
  @@index([threadId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int      @default(1)
  reviewId  String?
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  newsId    String?
  news      NewsPost? @relation(fields: [newsId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@unique([userId, commentId])
  @@unique([userId, postId])
  @@unique([userId, newsId])
  @@index([userId, createdAt])
  @@index([reviewId])
  @@index([commentId])
  @@index([postId])
  @@index([newsId])
}

// Otvorenie zdieľaného článku cez zdieľací odkaz (štatistika pre administráciu).
// visitorHash = nevratný odtlačok (IP + prehliadač) na počítanie unikátnych
// návštevníkov — samotná IP adresa sa neukladá.
model ArticleShareView {
  id          String   @id @default(cuid())
  articleType String
  articleId   String
  visitorHash String
  source      String?
  createdAt   DateTime @default(now())

  @@index([articleType, articleId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ANALYTIKA ZDIEĽANÝCH ČLÁNKOV (privacy by design — bez cookies, bez plných IP)
// ---------------------------------------------------------------------------

// Denná náhodná „soľ“ na anonymizáciu návštev. Uchováva sa len dnešná
// a včerajšia — po zmazaní sa už nedá zistiť, ktorá IP patrila ktorej návšteve.
model AnalyticsSalt {
  day       String   @id // 'YYYY-MM-DD'
  salt      String
  createdAt DateTime @default(now())
}

// Jedna návšteva (relácia) z vonku — podrobnosti sa uchovávajú 30 dní.
model VisitorSession {
  id           String   @id // HMAC(denná soľ, skrátená IP + prehliadač + OS + deň) — nevratné
  firstSeen    DateTime @default(now())
  lastSeen     DateTime @default(now())
  sourceTag    String? // umiestnenie zo zdieľacieho odkazu, napr. 'csfd-diskuse-film-x'
  referrerHost String? // len doména, napr. 'csfd.cz'
  deviceType   String? // mobile | tablet | desktop
  os           String? // 'iOS 18'
  browser      String? // 'Safari 18'
  country      String? // 'CZ'
  region       String? // kód kraja od Vercelu
  city         String?
  asn          Int?
  asnOrg       String? // poskytovateľ pripojenia (sieť), nie predplatiteľ
  pages        Int      @default(1)
  visits       ShareVisit[]

  @@index([firstSeen])
  @@index([sourceTag])
}

// Jedno zobrazenie zdieľaného článku v rámci návštevy.
model ShareVisit {
  id          String         @id @default(cuid())
  sessionId   String
  session     VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  articleType String // news | blog
  articleId   String
  visitedAt   DateTime       @default(now())

  @@index([articleType, articleId, visitedAt])
  @@index([visitedAt])
}

// Trvalé anonymné súhrny (po dňoch) — ostávajú aj po zmazaní podrobností.
model ShareDailyStat {
  day          String // 'YYYY-MM-DD'
  articleType  String
  articleId    String
  sourceTag    String @default("")
  referrerHost String @default("")
  country      String @default("")
  deviceType   String @default("")
  visits       Int
  sessions     Int

  @@id([day, articleType, articleId, sourceTag, referrerHost, country, deviceType])
  @@index([articleType, articleId])
}

// Evidencia žiadostí orgánov (polícia, súd…) a toho, čo bolo vydané.
model LegalRequest {
  id          String   @id @default(cuid())
  receivedAt  DateTime @default(now())
  authority   String
  referenceNo String
  legalBasis  String
  scope       String
  provided    String?
  status      String   @default("open") // open | done | rejected
  handledBy   String
  note        String?
  createdAt   DateTime @default(now())

  @@index([receivedAt])
}

model RecentlyViewed {
  id       String   @id @default(cuid())
  userId   String
  movieId  String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId, viewedAt])
}

model FanFavorite {
  id          String   @id @default(cuid())
  rank        Int
  sourceId    String   @unique
  title       String
  year        Int?
  tmdbId      Int?
  mediaType   String?
  movieId     String?
  movie       Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)
  importError String?
  updatedAt   DateTime @default(now())

  @@index([rank])
}

model EmailThrottle {
  key    String   @id
  sentAt DateTime @default(now())

  @@index([sentAt])
}
